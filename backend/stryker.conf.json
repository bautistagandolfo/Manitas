{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "jest",
  "reporters": ["clear-text", "progress", "json"],
  "coverageAnalysis": "perTest",
  "mutate": ["src/modules/stock/**/*.service.ts"],
  "jest": {
    "projectType": "custom",
    "configFile": "package.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "timeoutMS": 60000
}
